# Copy to .env and fill in. Never commit .env.
# Same value as the agent's AUTH_API_KEY, so the UI needs only one key.
AUTH_API_KEY=

# Bedrock API key for the LLM judge / intent classifier and the batch judge (the only AWS credential used)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# QA_JUDGE_MODEL=us.amazon.nova-pro-v1:0

# Optional
# PORT=8001
# DATA_DIR=./data
# CORS_ORIGINS=http://localhost:5173
# UI_DIST=../voice-eval-ui/dist        # serve the built UI from this process
