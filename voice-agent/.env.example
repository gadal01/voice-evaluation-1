# Copy to .env and fill in. Never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials
AWS_REGION=us-east-1

# WebSocket auth (see auth.py)
# JWT_SECRET: random, at least 32 characters:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# AUTH_API_KEY: what a client presents to POST /auth/token. The QA backend and UI use the same value.
AUTH_API_KEY=
# JWT_TTL_SECONDS=300

# Optional
# PORT=8000
# NOVA_SONIC_VOICE=matthew
# CORS_ORIGINS=http://localhost:5173      # browser origins allowed to call /auth/token (QA UI served elsewhere)
