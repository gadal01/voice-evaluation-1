# Copy to .env and fill in. Never commit .env.

# The voice agent's AUTH_API_KEY (must match the agent's own .env)
AUTH_API_KEY=

# Bedrock API key: the dynamic (LLM) user and the judge
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Optional
# AGENT_URL=ws://127.0.0.1:8000/ws
# JUDGE_MODEL=us.amazon.nova-pro-v1:0
# USER_MODEL=us.amazon.nova-pro-v1:0

# FastAPI layer (python -m sim.api)
# SIM_API_KEY=            # X-API-Key clients send; falls back to AUTH_API_KEY when unset
# API_PORT=8100
# RESULTS_DIR=./results
# MAX_ACTIVE_RUNS=1       # runs at once through the API (every run costs money)
